{
  "name": "@antora-supplemental/linkinator",
  "version": "0.1.1",
  "description": "Link-inator: click-time outbound link validity hints + archive.org/Wayback button (Antora UI bolt-on)",
  "license": "MIT",
  "author": "Ryan Johnson (https://github.com/AMDphreak)",
  "keywords": [
    "antora",
    "antora-extension",
    "linkinator",
    "wayback",
    "archive.org"
  ],
  "homepage": "https://github.com/antora-supplemental/linkinator",
  "bugs": {
    "url": "https://github.com/antora-supplemental/linkinator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/linkinator.git"
  },
  "main": "lib/extension.js",
  "exports": {
    ".": "./lib/extension.js",
    "./package.json": "./package.json",
    "./registry": "./lib/registry-meta.js"
  },
  "files": [
    "lib/**/*",
    "ui/**/*",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE",
    "antora-registry.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@antora/site-generator": ">=3.1.0"
  },
  "peerDependenciesMeta": {
    "@antora/site-generator": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0"
}
